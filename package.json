{
  "name": "money",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:demo": "vite --mode demo --host 0.0.0.0 --port 5175 --strictPort",
    "build": "tsc -b && vite build && node scripts/check-build.mjs dist household",
    "build:demo": "tsc -b && vite build --mode demo && node scripts/check-build.mjs dist-demo demo",
    "preview": "vite preview --host 0.0.0.0 --port 5173 --strictPort",
    "preview:demo": "vite preview --mode demo --host 0.0.0.0 --port 5175 --strictPort",
    "check": "biome check src tests scripts vite.config.ts",
    "test": "node --test tests/*.test.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "d3-sankey": "0.12.3",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/d3-sankey": "0.12.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
